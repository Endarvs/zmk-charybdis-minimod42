/*
 * Конвейер обработки трекбола Charybdis Mini MOD (ZMK Input Processors)
 * Подключается автоматически на центральной стороне (charybdis_right или charybdis_dongle).
 *
 * Слои (синхронизированы с config/charybdis.keymap):
 *   6 = L_MOUSE  (Auto-Mouse: автоматически включается при движении шара)
 *   7 = L_SNIPE  (Снайперский режим: замедление курсора в 3 раза для точной работы)
 *   8 = L_SCROLL (Режим 2D-скролла: превращает вращение шара в вертикальную и горизонтальную прокрутку)
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/*
 * Настройка Auto-Mouse (&zip_temp_layer):
 * - require-prior-idle-ms = <200>: защита от ложного срабатывания во время быстрой печати
 *   (если после нажатия клавиши прошло меньше 200 мс, лёгкое касание шара не переключит слой).
 * - excluded-positions: индексы клавиш мыши/модификаторов на слое L_MOUSE (6), нажатие которых
 *   НЕ сбрасывает слой мыши (позволяет кликать левой и правой рукой сколько угодно).
 *   Любая другая клавиша мгновенно выключает слой мыши и печатает символ!
 */
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <
        13 14 15 16 17  /* Левая рука: Snipe, RCLK, MCLK, LCLK, Scroll */
        18 19 20 21 22  /* Правая рука: Snipe, LCLK, MCLK, RCLK, Scroll */
        27 28 31 32     /* Кнопки браузера Назад/Вперёд (MB4 / MB5) */
        36 38 39 41     /* Тамб-кластер: Scroll, LCLK, RCLK, MCLK */
    >;
};

&trackball_listener {
    /* Обычное движение курсора + автоматическое включение слоя L_MOUSE (6) на 800 мс */
    input-processors = <&zip_temp_layer 6 800>;

    /* Слой 8 (L_SCROLL): плавная 2D-прокрутка трекболом (вертикальная + горизонтальная) */
    scroller: scroller {
        layers = <8>;
        input-processors = <
            &zip_xy_scaler 1 16
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    /* Слой 7 (L_SNIPE): замедление курсора 1:3 для попиксельного прицеливания */
    snipe: snipe {
        layers = <7>;
        input-processors = <
            &zip_xy_scaler 1 3
            &zip_temp_layer 6 800
        >;
    };
};
