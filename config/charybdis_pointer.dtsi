/*
 * Конвейер обработки трекбола Charybdis Mini MOD (ZMK Input Processors)
 * Подключается автоматически на центральной стороне (charybdis_right или charybdis_dongle).
 *
 * Слои (синхронизированы с config/charybdis.keymap):
 *   6 = L_MOUSE  (Auto-Mouse: автоматически включается при движении шара)
 *   7 = L_SNIPE  (Снайперский режим: замедление курсора в 3 раза для точной работы)
 *   8 = L_SCROLL (Режим 2D-скролла: превращает вращение шара в вертикальную и горизонтальную прокрутку)
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/*
 * Настройка Auto-Mouse (&zip_temp_layer):
 * - require-prior-idle-ms = <350>: защита от ложного срабатывания во время быстрой печати
 *   (если после нажатия клавиши прошло меньше 350 мс, вибрация стола от печати НЕ включит слой мыши).
 * - excluded-positions: клавиши мыши, нажатие которых НЕ сбрасывает слой L_MOUSE:
 *     E (03 = Scroll), R (04 = Snipe)
 *     S (14 = RCLK), D (15 = MCLK), F (16 = LCLK)
 *     J (19 = LCLK), K (20 = MCLK), L (21 = RCLK)
 *     Тамб-кластеры 36..41 (большой палец на шаре)
 */
&zip_temp_layer {
    require-prior-idle-ms = <350>;
    excluded-positions = <
        3 4
        14 15 16
        19 20 21
        36 37 38 39 40 41
    >;
};

&trackball_listener {
    /* Аппаратный множитель скорости 2x + автоматическое включение слоя L_MOUSE (6) на 800 мс */
    input-processors = <
        &zip_xy_scaler 2 1
        &zip_temp_layer 6 800
    >;

    /* Слой 8 (L_SCROLL): плавная 2D-прокрутка трекболом (вертикальная + горизонтальная) */
    scroller: scroller {
        layers = <8>;
        input-processors = <
            &zip_xy_scaler 1 16
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    /* Слой 7 (L_SNIPE): замедление курсора 1:3 для попиксельного прицеливания */
    snipe: snipe {
        layers = <7>;
        input-processors = <
            &zip_xy_scaler 1 3
            &zip_temp_layer 6 800
        >;
    };
};
