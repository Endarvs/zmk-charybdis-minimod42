/*
 * Комбо-сочетания для Charybdis Mini MOD (42 клавиши: 3x6 + 3L/3R Thumbs)
 *
 * Точные комбо вместо отсутствующих центральных клавиш Corne V4:
 *   R + T (04 + 05) -> Esc
 *   F + G (16 + 17) -> Tab
 *   Y + I (06 + 08) -> LSA(2) (Переключение на EN в Windows)
 *   H + J (18 + 19) -> LSA(3) (Переключение на RU в Windows)
 */

/ {
    combos {
        compatible = "zmk,combos";

        /* R + T (4 + 5) -> Esc */
        combo_esc {
            timeout-ms = <45>;
            key-positions = <4 5>;
            bindings = <&kp ESC>;
            layers = <0 1 2 3>;
        };

        /* F + G (16 + 17) -> Tab */
        combo_tab {
            timeout-ms = <45>;
            key-positions = <16 17>;
            bindings = <&kp TAB>;
            layers = <0 1 2 3>;
        };

        /* Y + I (6 + 8) -> LSA(2) (EN) */
        combo_lsa2_en {
            timeout-ms = <50>;
            key-positions = <6 8>;
            bindings = <&kp LA(LS(N2))>;
            layers = <0 1 2 3>;
        };

        /* H + J (18 + 19) -> LSA(3) (RU) */
        combo_lsa3_ru {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp LA(LS(N3))>;
            layers = <0 1 2 3>;
        };
    };
};
