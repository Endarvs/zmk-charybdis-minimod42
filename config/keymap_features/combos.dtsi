/*
 * Комбо-сочетания для Charybdis Mini MOD (42 клавиши: 3x6 + 3L/3R Thumbs)
 *
 * Точные комбо:
 *   R + T (04 + 05) -> Esc
 *   F + G (16 + 17) -> Tab
 *   U + I (07 + 08) -> LSA(2) (Переключение на EN в Windows)
 *   J + K (19 + 20) -> LSA(3) (Переключение на RU в Windows)
 */

/ {
    combos {
        compatible = "zmk,combos";

        /* R + T (4 + 5) -> Esc */
        combo_esc {
            timeout-ms = <45>;
            key-positions = <4 5>;
            bindings = <&kp ESC>;
            layers = <0 1 2 3>;
        };

        /* F + G (16 + 17) -> Tab */
        combo_tab {
            timeout-ms = <45>;
            key-positions = <16 17>;
            bindings = <&kp TAB>;
            layers = <0 1 2 3>;
        };

        /* U + I (7 + 8) -> Alt+Shift+2 (Английский EN в Windows) */
        combo_lsa2_en {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&lang_en>;
            layers = <0 1 2 3>;
        };

        /* J + K (19 + 20) -> Alt+Shift+3 (Русский RU в Windows) */
        combo_lsa3_ru {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&lang_ru>;
            layers = <0 1 2 3>;
        };
    };
};
